# svc-agent – copy thành .env.local khi chạy local (KHÔNG commit giá trị thật)
APP_ENV=dev
LOG_LEVEL=INFO
DB_URL=sqlite:///./agent.db
# App được phép gọi svc-agent (token dùng chung với app đó: svc-hrm đặt AGENT_SERVICE_TOKEN cùng giá trị)
SERVICE_TOKENS={"hrm":"dev-hrm-token"}
# MCP server được phép gọi (allowlist theo key)
MCP_SERVERS={"hrm":{"url":"http://127.0.0.1:8000/mcp","title":"HRM – Nhân sự","apps":["hrm"],"icon":"pi pi-users","color":"#2563eb"}}
# Token RIÊNG cho từng MCP server (X-Agent-Token). Nguồn không khai báo → dùng token của app (SERVICE_TOKENS)
MCP_TOKENS={}
LLM_TIMEOUT_SECONDS=120
MCP_TIMEOUT_SECONDS=20
TOOLS_CACHE_SECONDS=60
PATH_PREFIX=
